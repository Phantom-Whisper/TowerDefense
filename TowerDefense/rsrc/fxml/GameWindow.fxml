<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.geometry.Insets?>
<HBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="views.GameWindowController">
   <AnchorPane HBox.hgrow="ALWAYS">
       <fx:include source="Board.fxml" fx:id="boardView" />
   </AnchorPane>

    <VBox prefWidth="280" spacing="15"
          style="-fx-background-color: #2b2b2b;">
        <VBox.margin>
            <Insets top="10" right="10" bottom="10" left="10" />
        </VBox.margin>

        <fx:include source="Info.fxml" fx:id="infoView" />
        <fx:include source="Shop.fxml" fx:id="shopView" />
    </VBox>
</HBox>
